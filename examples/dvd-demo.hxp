;; nice bright colours
(def colours
  (list '#ff0000'
        '#00ff00'
        '#0000ff'
        '#ffff00'
        '#ff00ff'
        '#00ffff'))

;; collision radius for logo
(def r 100)

;; add two vectors together
(def add-v
  (fn (v1 v2)
    (let (x1 (first v1)
          y1 (last v1)
          x2 (first v2)
          y2 (last v2))
      (list (+ x1 x2)
            (+ y1 y2)))))

;; returns the updated x velocity and whether to change colour
(def update-vx
  (fn (vx pos vel)
    (if (or (< r (first pos))
            (< (first pos) (- r)))
      (let (vx (- (first vel)))
        (list vx true))
      (list (first vel) false))))

;; returns the updated y velocity and whether to change colour
(def update-vy
  (fn (vy pos vel)
    (if (or (< r (last pos))
            (< (last pos) (- r)))
      (let (vy  (- (last vel)))
        (list vy true))
      (list (last vel) false))))

;; defining `hexp-init`, it will be called once, before the first `hexp-update` or `hexp-draw`. it returns the `state` map
(def hexp-init
  (fn ()
    {'pos'    (0 40)
     'vel'    (3 3)
     'colour' '#ff0000'}))

;; defining `hexp-update`, it will be called every frame
(def hexp-update
  (fn (state)
    (let (pos (get state 'pos')
          vel (get state 'vel')
          colour (get state 'colour')
          vx-res (update-vx (first vel) pos vel)
          vy-res (update-vy (last vel) pos vel)
          new-vx (first vx-res)
          new-vy (first vy-res)
          new-vel (list new-vx new-vy)
          new-pos (add-v pos new-vel)
          change-colour? (or (last vx-res)
                             (last vy-res))
          new-colour (if change-colour?
                       (rand-nth colours)
                       colour))
      (put
       (put
        (put
         state
         'vel' new-vel)
        'pos' new-pos)
       'colour' new-colour))))

;; defining `hexp-draw`, will be called every frame
(def hexp-draw
  (fn (state)
    (let (pos (get state 'pos')
          colour (get state 'colour'))
      ;; set the background to a dark blue
      (background '#002b36')
      ;; draw the DVD logo in the current colour
      (draw-text pos 'DVD' colour))))
